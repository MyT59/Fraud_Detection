{
  "domain": "nusabill",
  "dataset": "retrain_hybrid_dataset",
  "rows": 5000,
  "contamination": 0.05,
  "anomaly_rate_fit_data": 0.05,
  "thresholds": {
    "review_score_threshold": 0.0357,
    "high_risk_score_threshold": -0.0298
  },
  "numeric_features": [
    "BILL_AMOUNT",
    "PAYMENT_AMOUNT",
    "REFUND_FLAG",
    "PAYMENT_DELAY_DAYS",
    "PAYMENT_TO_BILL_RATIO",
    "UNDERPAY_FLAG",
    "HIGH_SPIKE_FLAG",
    "CHANNEL_API_FLAG",
    "PAYMENT_GAP_MINUTES",
    "BURST_FLAG",
    "CHANNEL_SWITCH_TO_API",
    "EARLY_PAYMENT_ANOMALY"
  ],
  "categorical_features": [
    "CHANNEL",
    "BILL_STATUS"
  ],
  "model_path": "backend\\app\\infrastructure\\ml\\models\\nusabill_isolation_forest.pkl"
}